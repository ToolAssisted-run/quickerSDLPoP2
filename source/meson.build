# quickerSDLPoP2: the core is a single header; the instance adapts it to JaffarPlus
quickerSDLPoP2Dependency = declare_dependency(
  include_directories : include_directories([ '.', 'quickerSDLPoP2' ]),
)

# The oracle instance's include path (the SDLPoP2 core itself comes from the SDLPoP2 subproject)
oracleDependency = declare_dependency(
  include_directories : include_directories([ '.' ]),
)
